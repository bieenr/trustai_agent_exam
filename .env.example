OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trusted-ai-movie-agent

# Embedding server (OpenAI-compatible /v1/embeddings, e.g. vLLM serving Qwen3-Embedding)
EMBEDDING_BASE_URL=http://<server>:8888/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_TIMEOUT_S=60
EMBEDDING_MAX_CHARS=6000
